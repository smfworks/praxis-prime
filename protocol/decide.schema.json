{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smfworks/praxis-prime/protocol/decide.schema.json",
  "title": "Praxis Prime local Decision Engine",
  "description": "Request and response for POST /v1/decide and POST /v1/systemone. Local only. Not a TypeSafe API.",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"}
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "model": {"type": "string"},
        "state": {"type": ["object", "string", "array"]},
        "questions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/question"}
        },
        "x_prime": {"$ref": "#/$defs/requestExtension"}
      }
    },
    "question": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["choice", "score", "noul", "yesno"]},
        "instructions": {"type": ["string", "object", "array"]},
        "criteria": {"type": ["object", "array", "string"]}
      }
    },
    "requestExtension": {
      "type": "object",
      "properties": {
        "purpose": {"type": "string"},
        "data_class": {"type": "string"},
        "max_tier": {"type": ["integer", "string"]},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "latency_budget_ms": {"type": "integer", "minimum": 0},
        "explain": {"type": "boolean"}
      }
    },
    "response": {
      "type": "object",
      "required": ["model", "answers", "x_prime"],
      "properties": {
        "model": {"type": "string"},
        "decision_id": {"type": "string"},
        "answers": {"type": "object"},
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {"type": "integer"},
            "output_tokens": {"type": "integer"}
          }
        },
        "x_prime": {
          "type": "object",
          "properties": {
            "decision_id": {"type": "string"},
            "audit_seq": {"type": ["integer", "null"]},
            "tiers": {"type": "object"},
            "confidence": {"type": "object"},
            "escalate": {"type": "boolean"},
            "latency_ms": {"type": "number"},
            "cost_usd": {"type": "number"},
            "explain": {"type": "object"},
            "jury": {"type": "object"}
          }
        }
      }
    }
  }
}
