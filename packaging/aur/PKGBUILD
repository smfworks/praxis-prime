# Maintainer: SMF Works <maintainers@praxis-prime.invalid>
# praxis-prime-git builds from the git tree into /opt/praxis-prime.
# Not submitted to the AUR. The .invalid maintainer address does not receive mail.
# praxis-prime-bin is a future package for a versioned release tarball
# (ARCHITECTURE §27.2). Do not publish that name until the tarball exists.

pkgname=praxis-prime-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Local-first autonomous AI agent for Linux (pre-alpha, not in the AUR)"
# makepkg builds the virtualenv on the target machine, so native wheels match
# that machine. This is not a prebuilt binary. praxis-prime-bin would name
# an architecture when a release tarball exists.
arch=('any')
url="https://github.com/smfworks/praxis-prime"
license=('MIT')
depends=('python>=3.12')
# python-installer is the usual Arch wheel installer. package() uses pip
# into a virtualenv instead: installer --destdir does not fetch PyPI
# dependencies, and joserfc and webauthn are not assumed to be pacman packages.
makedepends=(
  'git'
  'python-build'
  'python-installer'
  'python-wheel'
  'python-hatchling'
  'python-pip'
)
provides=('praxis-prime')
conflicts=('praxis-prime-bin')
options=('!strip')
source=("git+https://github.com/smfworks/praxis-prime.git")
sha256sums=('SKIP')

pkgver() {
  cd praxis-prime
  local base count rev
  base=$(sed -n 's/^__version__ = "\([^"]*\)"/\1/p' packages/prime-core/praxis_prime/__init__.py)
  count=$(git rev-list --count HEAD)
  rev=$(git rev-parse --short HEAD)
  printf '%s.r%s.%s' "${base:-0.1.0}" "$count" "$rev"
}

build() {
  cd praxis-prime
  python -m build --wheel --no-isolation --outdir dist
}

package() {
  cd praxis-prime
  local venv="${pkgdir}/opt/praxis-prime"
  python -m venv "${venv}"
  "${venv}/bin/pip" install \
    --disable-pip-version-check \
    --no-cache-dir \
    --no-compile \
    --index-url https://pypi.org/simple \
    dist/*.whl

  find "${venv}" -type d -name '__pycache__' -print0 | xargs -0 -r rm -rf
  find "${venv}" -type f -name '*.pyc' -delete
  find "${venv}" -type f -name 'direct_url.json' -delete
  rm -f "${venv}/.gitignore" "${venv}/.lock" "${venv}/CACHEDIR.TAG"
  find "${venv}" -type d -exec chmod 0755 {} +
  find "${venv}" -type f -exec chmod 0644 {} +
  find "${venv}/bin" -type f -exec chmod 0755 {} +

  local file
  while IFS= read -r -d '' file; do
    if grep -I -q -F "${venv}" "${file}"; then
      sed -i "s|${venv}|/opt/praxis-prime|g" "${file}"
    fi
  done < <(find "${venv}" -type f -print0)

  local cmd
  install -d "${pkgdir}/usr/bin"
  for cmd in praxis-prime pprime praxis-primed; do
    [[ -x "${venv}/bin/${cmd}" ]]
    ln -s "/opt/praxis-prime/bin/${cmd}" "${pkgdir}/usr/bin/${cmd}"
  done

  install -d "${pkgdir}/usr/lib/systemd/user"
  local unit
  for unit in packaging/systemd/*.service packaging/systemd/*.timer packaging/systemd/*.slice; do
    install -Dm644 "${unit}" "${pkgdir}/usr/lib/systemd/user/$(basename "${unit}")"
  done

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 NOTICE "${pkgdir}/usr/share/licenses/${pkgname}/NOTICE"
  install -Dm644 THIRD_PARTY.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY.md"
  install -Dm644 THIRD_PARTY_NOTICES.md "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
  install -Dm644 packaging/deb/debian/copyright \
    "${pkgdir}/usr/share/licenses/${pkgname}/copyright"
}
