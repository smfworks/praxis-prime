#!/usr/bin/make -f
# Praxis Prime does not use debhelper. Build the binary package with
# packaging/deb/build-deb.sh, which needs no root. See packaging/deb/README.md.

.PHONY: binary build clean
binary build clean:
	@echo "praxis-prime: run packaging/deb/build-deb.sh (debhelper is not required)." >&2
	@exit 1
